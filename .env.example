# SiliconFlow uses an OpenAI-compatible endpoint. Keep the real key in a
# Windows environment variable named glm_api, or replace the reference locally.
CODE_AGENT_MODEL=openai/Pro/zai-org/GLM-5.1
OPENAI_API_KEY=${GLM_API}
OPENAI_API_BASE=https://api.siliconflow.cn/v1

# Windows path to Git Bash. Change it if Git is installed elsewhere.
CODE_AGENT_BASH_PATH=C:\Program Files\Git\bin\bash.exe
