# SiliconFlow uses an OpenAI-compatible endpoint. Keep the real key in the
# Windows environment variable named SILICONFLOW_API_KEY.
CODE_AGENT_MODEL=openai/deepseek-ai/DeepSeek-V4-Flash
OPENAI_API_KEY=${SILICONFLOW_API_KEY}
# Optional. If omitted, embedding calls fall back to OPENAI_API_KEY.
SILICONFLOW_EMBEDDING_API_KEY=${SILICONFLOW_API_KEY}
OPENAI_API_BASE=https://api.siliconflow.cn/v1

# Windows path to Git Bash. Change it if Git is installed elsewhere.
CODE_AGENT_BASH_PATH=C:\Program Files\Git\bin\bash.exe
